{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instance-bound local state format v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program_version",
    "format_version",
    "published_at",
    "min_reader",
    "min_writer",
    "state_directory_id",
    "instance_id"
  ],
  "properties": {
    "schema": {
      "const": "state-format/v2"
    },
    "program_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "format_version": {
      "const": 2
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "min_reader": {
      "type": "integer",
      "minimum": 1
    },
    "min_writer": {
      "type": "integer",
      "minimum": 1
    },
    "state_directory_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "description": "Runtime validates instance/directory binding, reader and writer ranges, duplicate keys and the 4096 byte limit. Not an authorization or same-UID isolation boundary."
}
