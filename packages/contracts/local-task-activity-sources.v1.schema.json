{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "local-task-activity-sources/v1"
    },
    "activity_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "view": {
      "enum": [
        "tasks",
        "unassigned"
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "receipt_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "verified_source",
              "unavailable",
              "unattributed"
            ]
          },
          "source": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "grant_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "admission_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "permission_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "skill_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "declared_version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "import": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "schema_version": {
                            "const": "local-skill-import-permission-source/v1"
                          },
                          "import_id": {
                            "type": "string",
                            "pattern": "^si-[a-f0-9]{32}$"
                          },
                          "artifact_digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "analysis_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "schema_version",
                          "import_id",
                          "artifact_digest",
                          "analysis_sha256"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "grant_id",
                  "admission_id",
                  "permission_digest",
                  "skill_name",
                  "declared_version",
                  "content_hash",
                  "import"
                ]
              }
            ]
          }
        },
        "required": [
          "seq",
          "receipt_hash",
          "status",
          "source"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified_source"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "grant_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "admission_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "permission_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "skill_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "declared_version": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "content_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "import": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "schema_version": {
                              "const": "local-skill-import-permission-source/v1"
                            },
                            "import_id": {
                              "type": "string",
                              "pattern": "^si-[a-f0-9]{32}$"
                            },
                            "artifact_digest": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "analysis_sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "schema_version",
                            "import_id",
                            "artifact_digest",
                            "analysis_sha256"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "grant_id",
                    "admission_id",
                    "permission_digest",
                    "skill_name",
                    "declared_version",
                    "content_hash",
                    "import"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "source": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "activity_id",
    "snapshot",
    "view",
    "offset",
    "total",
    "next_offset",
    "items"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
