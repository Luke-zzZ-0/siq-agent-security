{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-activation.v1.schema.json",
  "title": "Signed immutable raw task content activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "actor_ref",
    "activated_at",
    "retention_seconds",
    "budget_bytes",
    "key_fingerprint",
    "signing_schema",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-activation/v1" },
    "enabled": { "const": true },
    "actor_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "activated_at": { "type": "string", "format": "date-time" },
    "retention_seconds": { "type": "integer", "minimum": 3600, "maximum": 2592000 },
    "budget_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
    "key_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signing_schema": { "const": "local_canonical/v1" },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
  }
}
