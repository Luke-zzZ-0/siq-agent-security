{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-skill-update-schedule-run.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "local-skill-update-schedule-run/v1"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "max_checks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    }
  }
}
