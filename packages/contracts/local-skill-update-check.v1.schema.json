{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-update-check.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "remote_url",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "local-skill-update-check/v1"
    },
    "remote_url": {
      "type": "string",
      "maxLength": 4096
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
    }
  }
}
