{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-status.v1.schema.json",
  "title": "Raw task content management status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "default_capture", "retention_seconds", "budget_bytes", "activated_at"],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-status/v1" },
    "status": { "enum": ["disabled", "ready", "error"] },
    "default_capture": { "const": false },
    "retention_seconds": { "type": ["integer", "null"] },
    "budget_bytes": { "type": ["integer", "null"] },
    "activated_at": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": {
        "properties": {
          "retention_seconds": { "type": "integer", "minimum": 3600, "maximum": 2592000 },
          "budget_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
          "activated_at": { "type": "string", "format": "date-time" }
        }
      },
      "else": {
        "properties": {
          "retention_seconds": { "type": "null" },
          "budget_bytes": { "type": "null" },
          "activated_at": { "type": "null" }
        }
      }
    }
  ]
}
