{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-service-stop-result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boot_id",
    "state_directory_id",
    "acceptance_sha256",
    "finished_at",
    "status",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "local-service-stop-result/v1"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_directory_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finished_at": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "drained",
        "drain_failed"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
