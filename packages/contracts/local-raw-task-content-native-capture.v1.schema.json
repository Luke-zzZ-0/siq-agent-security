{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-native-capture.v1.schema.json",
  "title": "Native runtime-bound raw task content capture request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "agent_id", "session_id", "kind", "fields"],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-native-capture/v1" },
    "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kind": { "enum": ["input", "parameters", "output", "note"] },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "secret"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "minLength": 1, "maxLength": 1048576 },
          "secret": { "type": "boolean" }
        }
      }
    }
  }
}
