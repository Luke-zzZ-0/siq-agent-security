{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-record.v1.schema.json",
  "title": "Verified raw task content record metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "record_id", "task_ref", "kind", "created_at", "expires_at", "plaintext_sha256", "plaintext_bytes", "omitted_secret_count"],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-record/v1" },
    "status": { "enum": ["active", "expired"] },
    "record_id": { "type": "string", "pattern": "^raw-[a-f0-9]{32}$" },
    "task_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "kind": { "enum": ["input", "parameters", "output", "note"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "plaintext_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plaintext_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "omitted_secret_count": { "type": "integer", "minimum": 0, "maximum": 1024 }
  }
}
