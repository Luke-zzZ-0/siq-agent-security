{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-capture.v1.schema.json",
  "title": "Runtime-bound structured raw task content capture request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "agent_id", "session_id", "task_id", "permit", "fields"],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-capture/v1" },
    "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "permit": { "$ref": "https://siq.dev/contracts/local-raw-task-content-capture-permit.v1.schema.json" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "secret"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "minLength": 1, "maxLength": 1048576 },
          "secret": { "type": "boolean" }
        }
      }
    }
  }
}
