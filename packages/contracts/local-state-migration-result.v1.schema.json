{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "format_version",
    "backup_entries"
  ],
  "properties": {
    "schema": {
      "const": "local-state-migration-result/v1"
    },
    "status": {
      "enum": [
        "migrated",
        "up_to_date"
      ]
    },
    "format_version": {
      "const": 2
    },
    "backup_entries": {
      "type": "integer",
      "minimum": 0
    }
  }
}
