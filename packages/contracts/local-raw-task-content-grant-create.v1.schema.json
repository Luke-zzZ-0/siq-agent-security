{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-raw-task-content-grant-create.v1.schema.json",
  "title": "Task-level raw content capture grant request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "kinds",
    "actor_id",
    "duration_seconds",
    "retention_seconds",
    "max_plaintext_bytes"
  ],
  "properties": {
    "schema_version": { "const": "local-raw-task-content-grant-create/v1" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["input", "parameters", "output", "note"] }
    },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "duration_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "retention_seconds": { "type": "integer", "minimum": 3600, "maximum": 2592000 },
    "max_plaintext_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
  }
}
