{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-import-git-create.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "url",
    "ref",
    "sub_dir",
    "expected_commit",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "local-skill-import-git-create/v1"
    },
    "import_id": {
      "type": "string",
      "pattern": "^si-[a-f0-9]{32}$"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^https://"
    },
    "ref": {
      "type": "string",
      "maxLength": 128
    },
    "sub_dir": {
      "type": "string",
      "maxLength": 4096
    },
    "expected_commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40})?$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
    }
  }
}
